# ===========================================
# Next.js / NextAuth Configuration
# ===========================================
# COPY THIS FILE TO .env.local

# NextAuth URL - Your frontend domain
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# ===========================================
# OIDC Provider Configuration
# ===========================================

# OIDC Issuer URL (your identity provider)
# Google: https://accounts.google.com
# Auth0: https://your-tenant.auth0.com/
# Okta: https://your-domain.okta.com/oauth2/default
OIDC_ISSUER_URL=https://accounts.google.com

# OIDC Client Credentials (from your identity provider)
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Public OIDC Issuer URL (for client-side logout)
NEXT_PUBLIC_OIDC_ISSUER_URL=https://accounts.google.com
NEXT_PUBLIC_OIDC_CLIENT_ID=your-client-id

# ===========================================
# Backend API Configuration
# ===========================================

# Backend API URL
# Development: http://localhost:3001
# Production: https://your-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

