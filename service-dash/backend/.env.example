# Database
DATABASE_URL="postgresql://user:password@localhost:5432/servicedash?schema=public"

# Server
PORT=3001

# OIDC Configuration
# NOTE: Use exact issuer URL from your IDP (match trailing slash if present)
# Example for Auth0: https://YOUR_DOMAIN.auth0.com/
OIDC_ISSUER_URL="https://your-idp.com"
OIDC_CLIENT_ID="your-client-id"
OIDC_CLIENT_SECRET="your-client-secret"
