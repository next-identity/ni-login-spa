# ===========================================
# Server Configuration
# ===========================================
# COPY THIS FILE TO .env

# Port for the Express server
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL connection string
# Development: Use local PostgreSQL or SQLite
# Production: Use Railway's PostgreSQL or your database provider
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/servicedash?schema=public

# ===========================================
# OIDC Configuration (for token validation)
# ===========================================

# OIDC Issuer URL (must match frontend)
OIDC_ISSUER_URL=https://accounts.google.com

# ===========================================
# DataSync API Configuration
# ===========================================

# DataSync API URL
# Development: https://dev.datasync.nextreasonservices.com
# Production: https://datasync.nextreasonservices.com
DATASYNC_URL=https://dev.datasync.nextreasonservices.com

# DataSync API Key
DATASYNC_API_KEY=your-datasync-api-key

